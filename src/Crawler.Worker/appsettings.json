{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5081",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Crawler": "Data Source=../../data/crawler.db"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "MaxDeliveryAttempts": 3,
    "RetryDelayMilliseconds": 10000,
    "PrefetchCount": 1
  },
  "Crawl": {
    "MaxPagesPerJob": 200,
    "MaxLinksPerPage": 1000
  }
}
